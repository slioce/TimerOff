<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for NotifyIcon, the tray icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TimerOff</RootNamespace>
    <ApplicationIcon>Assets\TimerOff.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Alessandro Lioce</Authors>
    <Copyright>© 2026 Alessandro Lioce</Copyright>
    <!-- ThemeMode (the Fluent theme) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the Windows Forms namespaces out of the implicit usings: WPF owns Application, Brush and friends. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimerOff.Core\TimerOff.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\TimerOff.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
